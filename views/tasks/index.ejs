<%- include("../partials/header", { title: `${team.name} のタスク` }) %>

<h1><%= team.name %> のタスク</h1>

<% const isLeader = team.role === "leader"; %>
<% const today = todayInJst(); %>

<form method="get" class="filters">
  <label>
    ステータス
    <select name="status">
      <option value="">すべて</option>
      <% statusOptions().forEach((option) => { %>
        <option value="<%= option.value %>"
                <%= filters.status === option.value ? "selected" : "" %>>
          <%= option.label %>
        </option>
      <% }) %>
    </select>
  </label>
  <label>
    担当者
    <select name="assignee">
      <option value="">すべて</option>
      <option value="none" <%= filters.assignee === "none" ? "selected" : "" %>>
        未割り当て
      </option>
      <% members.forEach((member) => { %>
        <option value="<%= member.id %>"
                <%= filters.assignee === String(member.id) ? "selected" : "" %>>
          <%= member.name %>
        </option>
      <% }) %>
    </select>
  </label>
  <label>
    並べ替え
    <select name="sort">
      <option value="due_date" <%= filters.sort === "due_date" ? "selected" : "" %>>期限順</option>
      <option value="status" <%= filters.sort === "status" ? "selected" : "" %>>ステータス順</option>
      <option value="created_at" <%= filters.sort === "created_at" ? "selected" : "" %>>作成が新しい順</option>
    </select>
  </label>
  <button type="submit">絞り込む</button>
</form>

<% if (isLeader) { %>
  <p><a href="/teams/<%= team.id %>/tasks/new">タスクを作る</a></p>
<% } %>

<% if (tasks.length === 0) { %>
  <p>該当するタスクはありません。</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>タイトル</th>
        <th>ステータス</th>
        <th>担当者</th>
        <th>期限</th>
        <th>見積</th>
      </tr>
    </thead>
    <tbody>
      <% tasks.forEach((task) => { %>
        <% const overdue = task.due_date && task.due_date < today && task.status !== "done"; %>
        <tr>
          <td>
            <a href="/teams/<%= team.id %>/tasks/<%= task.id %>"><%= task.title %></a>
          </td>
          <td><%= statusLabel(task.status) %></td>
          <td><%= task.assignee_name ?? "未割り当て" %></td>
          <td class="<%= overdue ? "overdue" : "" %>">
            <%= formatDate(task.due_date) || "—" %>
            <% if (overdue) { %>（期限切れ）<% } %>
          </td>
          <td><%= formatMinutes(task.estimated_minutes) || "—" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<p>
  <a href="/teams/<%= team.id %>/dashboard">ダッシュボード</a> ／
  <a href="/teams/<%= team.id %>">チームの画面</a>
</p>

<%- include("../partials/footer") %>
