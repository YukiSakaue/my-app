<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${locals.title} | タスク管理` : "タスク管理" %></title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; margin: 0; color: #222; }
    header { display: flex; justify-content: space-between; align-items: center;
             gap: 1rem; padding: .75rem 1.5rem; border-bottom: 1px solid #ddd; }
    header a { color: inherit; text-decoration: none; font-weight: 600; }
    main { max-width: 40rem; margin: 0 auto; padding: 1.5rem; }
    label { display: block; margin-top: 1rem; }
    input[type=text], input[type=email], input[type=password] {
      width: 100%; padding: .5rem; margin-top: .25rem; box-sizing: border-box;
      border: 1px solid #bbb; border-radius: 4px; font-size: 1rem; }
    button { margin-top: 1.25rem; padding: .5rem 1.25rem; font-size: 1rem;
             border: 1px solid #333; border-radius: 4px; background: #333;
             color: #fff; cursor: pointer; }
    header button { margin: 0; padding: .25rem .75rem; font-size: .875rem; }
    .errors { border: 1px solid #c00; background: #fdf0f0; color: #900;
              padding: .75rem 1rem; border-radius: 4px; margin: 1rem 0; }
    .errors ul { margin: 0; padding-left: 1.25rem; }
    table { border-collapse: collapse; width: 100%; margin-top: .5rem; }
    th, td { border-bottom: 1px solid #ddd; padding: .5rem; text-align: left; }
    td form { margin: 0; }
    td button { margin: 0; padding: .25rem .75rem; font-size: .875rem; }
    .invite-code { font-size: 1.5rem; letter-spacing: .15em; background: #f2f2f2;
                   padding: .25rem .75rem; border-radius: 4px; }
    textarea, select { width: 100%; padding: .5rem; margin-top: .25rem;
                       box-sizing: border-box; border: 1px solid #bbb;
                       border-radius: 4px; font-size: 1rem; font-family: inherit; }
    .filters { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
    .filters label { margin-top: 0; flex: 1 1 8rem; }
    .filters button { margin-top: 0; }
    .overdue { color: #c00; font-weight: 600; }
    .description { white-space: pre-wrap; }
    dl { display: grid; grid-template-columns: 8rem 1fr; gap: .25rem 1rem; }
    dt { font-weight: 600; }
    dd { margin: 0; }
    .running-timer { display: flex; justify-content: space-between; align-items: center;
                     gap: 1rem; padding: .5rem 1.5rem; background: #fff6d6;
                     border-bottom: 1px solid #e0cf8a; font-weight: 600; }
    .running-timer form { margin: 0; }
    .running-timer button { margin: 0; padding: .25rem .75rem; font-size: .875rem; }
    .total-time { font-size: 1.125rem; font-weight: 600; }
    .trend { list-style: none; padding: 0; margin: 0; }
    .trend li { display: grid; grid-template-columns: 6rem 1fr auto;
                align-items: center; gap: .5rem; padding: .125rem 0; }
    .trend-date { font-size: .8125rem; color: #666; }
    .trend-bar { background: #4a7ebb; height: .75rem; border-radius: 2px; min-width: 0; }
    .trend-value { font-size: .8125rem; }
    header nav { display: flex; gap: 1rem; align-items: center; }
    header nav a { font-weight: 400; }
  </style>
</head>
<body>
  <header>
    <a href="/">タスク管理</a>
    <% if (locals.currentUser) { %>
      <nav>
        <a href="/me">自分のページ</a>
        <span><%= currentUser.name %></span>
        <form action="/logout" method="post">
          <button type="submit">ログアウト</button>
        </form>
      </nav>
    <% } %>
  </header>
  <% if (locals.runningTimer) { %>
    <div class="running-timer">
      <span>計測中：<%= runningTimer.task_title %></span>
      <form action="/teams/<%= runningTimer.team_id %>/tasks/<%= runningTimer.task_id %>/time-entries/stop"
            method="post">
        <button type="submit">停止する</button>
      </form>
    </div>
  <% } %>
  <main>
