// generator の設定じゃ。Prisma Client の場所を指定しておるぞ。
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// データベースの接続設定じゃ。
datasource db {
  provider = "postgresql"
}

// これが「User」テーブルの定義じゃ！これが無いと prisma.user が使えぬのじゃ。
model User {
  id   Int    @id @default(autoincrement())
  name String
}

