# このファイルを .env にコピーして値を埋める。.env は commit しない。

# PostgreSQL の接続 URL
# ローカル: postgresql://myapp:myapp@localhost:5432/my_app
# Render:  ダッシュボードの Connections にある External Database URL の末尾に
#          ?sslmode=verify-full を付ける（SSL 必須。証明書検証を無効化しないこと）
DATABASE_URL="postgresql://myapp:myapp@localhost:5432/my_app"

# JWT の署名鍵。推測されない十分に長い文字列にする。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# 省略時は 3000。Render では実行環境が自動で設定するため指定不要。
PORT=3000
