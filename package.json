{
  "name": "my-app",
  "version": "1.0.0",
  "type": "module",
  "description": "小規模チーム向けのタスク管理ツール",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:test": "node --env-file-if-exists=.env.test node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "test": "npm run migrate:test --silent && node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
